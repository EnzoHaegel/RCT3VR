#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION RCT3VR_VERSION_MAJOR, RCT3VR_VERSION_MINOR, RCT3VR_VERSION_PATCH, 0
PRODUCTVERSION RCT3VR_VERSION_MAJOR, RCT3VR_VERSION_MINOR, RCT3VR_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RCT3 VR mod"
            VALUE "FileDescription", "RCT3 VR: ride cameras in VR for RollerCoaster Tycoon 3 (Direct3D 9 proxy)"
            VALUE "FileVersion", RCT3VR_VERSION_STRING
            VALUE "InternalName", "rct3vr"
            VALUE "OriginalFilename", "d3d9.dll"
            VALUE "ProductName", "RCT3 VR"
            VALUE "ProductVersion", RCT3VR_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
